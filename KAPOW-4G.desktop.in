[Desktop Entry]
Version=1.0
Type=Application
Name=KAPOW 4G — SOL Miner
GenericName=Polaris Galaxy Hopper 4GB GPU Miner
Comment=Mine SOL with your 4GB AMD GPU (ALPH Blake3 via unMineable). Polaris Galaxy Hopper.
Icon=@KIT_DIR@/kapow4g.svg
Exec=x-terminal-emulator -T "KAPOW 4G — SOL MINER" -e "@KIT_DIR@/start-4g.sh"
Terminal=false
Categories=Network;Finance;
Keywords=miner;crypto;solana;kapow;amd;gpu;4g;polaris;
StartupNotify=true
