# ============================================================
#   KAPOW SOL Miner — your settings
#   install.sh copies this file to config.env and asks for your wallet.
#   You can also edit config.env by hand at any time.
# ============================================================

# Your Solana wallet address. This is where unMineable pays your SOL.
# Any Solana wallet works (Phantom, Solflare, Backpack, a hardware wallet, an exchange deposit address).
WALLET=

# A name for this rig, shown on your unMineable stats page. Letters and numbers only.
WORKER=rig1

# unMineable referral code. It is sent with every share: unMineable lowers YOUR pool fee from 1 % to 0.75 %
# and credits the Polaris Galaxy Hopper project. Leave it in to support the project, or clear it.
# Sign-up / stats page with the same code: https://unmineable.com/?ref=U-91QW42
REFERRAL=U-91QW42

# ---------- advanced: the defaults are right for almost everyone ----------

# 4 GB cards (RX 470 / 480 / 570 / 580 4 GB) mine ALPH (Blake3). The ETC DAG no longer fits in 4 GB.
POOL_4G=blake3.unmineable.com:3333
# 8 GB cards (RX 480 / 580 8 GB, Vega, RX 5700) mine ETCHASH.
POOL_8G=etchash.unmineable.com:3333

# Local stats API of the miner (loopback only). Used by the tools/ scripts.
API_PORT_4G=10081
API_PORT_8G=10082

# Extra TeamRedMiner flags, if you want them. Examples:
#   TRM_EXTRA="-d 0,1,2"              only use GPUs 0, 1 and 2
#   TRM_EXTRA="--temp_limit=80"       stop a GPU above 80 °C
TRM_EXTRA=
